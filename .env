# Data settings
DATA_DIRECTORY=data/
SLIDES_DIRECTORY=data/slides/
PRESENTATION_DIRECTORY=data/presentations/
DATABASE_STORAGE_PATH=database/

# Timings
WAIT_FOR_ANIMATIONS=1000
NAVIGATION_TIMEOUT=30000
SLIDE_VISIBLE_TIMEOUT=10000

# Task settings
TIME_BEFORE_CLEANUP=300 # Seconds
WAIT_BETWEEN_ACTIONS=300 # Miliseconds

# Quality
BROWSER_DIMENTIONS=1123,794
SCALE_FACTOR=2

# Performance
WORKERS_COUNT=1

# Dev
DEV_MODE=false
HEADLESS=true


